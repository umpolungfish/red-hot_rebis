                "domain_action": "Initialize the system with free glutamate molecules in the amino acid pool."
              },
              {
                "step_num": 2,
                "opcode": "⊣",
                "domain_action": "Anchor the N-terminus of the peptide chain, establishing the start of the polymer."
              },
              {
                "step_num": 3,
                "opcode": "≻",
                "domain_action": "Propagate the backbone from N-terminus to C-terminus, forming the primary structure."
              },
              {
                "step_num": 4,
                "opcode": "⋈",
                "domain_action": "Form the first peptide bond between the N-terminal amino group and the carboxyl group of the first glutamate residue."
              },
              {
                "step_num": 5,
                "opcode": "⊙",
                "domain_action": "Assert the identity of the first glutamate residue within the chain."
              },
              {
