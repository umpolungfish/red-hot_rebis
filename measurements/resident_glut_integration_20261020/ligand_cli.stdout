                "domain_action": "Propagate the backbone, linking methionine to adjacent residues."
              },
              {
                "step_num": 4,
                "opcode": "∈",
                "domain_action": "Branch the side-chain into multiple rotameric states."
              },
              {
                "step_num": 5,
                "opcode": "⊤",
                "domain_action": "Evaluate the stable conformation arm, affirming low-energy states."
              },
              {
                "step_num": 6,
                "opcode": "⊥",
                "domain_action": "Evaluate the steric clash arm, negating high-energy states."
              },
              {
                "step_num": 7,
