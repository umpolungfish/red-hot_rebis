# Red-Hot Rebis — .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# venv
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log

# LaTeX intermediates
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Backup files — never commit these
*.bak
*.p4rakernel_backup
*.zip
*.json.bak

# pytest
.pytest_cache/

# Stray junk
_write_test.txt

# External reference PDFs kept on disk, not in git (patents, etc.)
_archive/*.pdf

# Local measurements and execution receipts
measurements/

# --- local build and execution artifacts ---
*:Zone.Identifier
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.venv/
venv/
node_modules/
target/
*.rlib
*.rmeta
.DS_Store

measurements/global_protein_coverage_20261020/
